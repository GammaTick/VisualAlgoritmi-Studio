<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <AssemblyName>VisualAlgoritmi_Studio</AssemblyName>
    <Version>2.0.2</Version>
    <AssemblyVersion>2.0.2.0</AssemblyVersion>
    <FileVersion>2.0.2.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
	<AvaloniaResource Include="Assets\Styles\**" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="ProjectCore\Templates\ConsoleAppTemplate.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="ProjectCore\Templates\QueueExampleUsageTemplate.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="ProjectCore\Templates\StackExampleUsageTemplate.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="ProjectCore\Templates\ListExampleUsageTemplate.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="ProjectCore\Templates\ArrayListExampleUsageTemplate.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="ProjectCore\Templates\LinkedListExampleUsageTemplate.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.14">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.3.0" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisualAlgoritmi.Runtime\VisualAlgoritmi.Runtime.csproj" />
  </ItemGroup>
  
  <Target Name="BuildAndCopyUserCodeRunner" AfterTargets="Build">
	  <MSBuild
		Projects="..\UserCodeRunner\UserCodeRunner.csproj"
		Targets="Build"
		Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier)" />

	  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
		<UserCodeRunnerBuildFiles Include="..\UserCodeRunner\bin\$(Configuration)\$(TargetFramework)\**\*" />
	  </ItemGroup>

	  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
		<UserCodeRunnerBuildFiles Include="..\UserCodeRunner\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\**\*" />
	  </ItemGroup>

	  <Copy
		SourceFiles="@(UserCodeRunnerBuildFiles)"
		DestinationFiles="@(UserCodeRunnerBuildFiles->'$(OutDir)UserCodeRunner\%(RecursiveDir)%(Filename)%(Extension)')"
		SkipUnchangedFiles="true" />
	</Target>

	<Target Name="PublishAndCopyUserCodeRunner" AfterTargets="Publish">
	  <MSBuild
		Projects="..\UserCodeRunner\UserCodeRunner.csproj"
		Targets="Publish"
		Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)" />

	  <ItemGroup>
		<UserCodeRunnerPublishFiles Include="..\UserCodeRunner\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\**\*" />
	  </ItemGroup>

	  <Copy
		SourceFiles="@(UserCodeRunnerPublishFiles)"
		DestinationFiles="@(UserCodeRunnerPublishFiles->'$(PublishDir)UserCodeRunner\%(RecursiveDir)%(Filename)%(Extension)')"
		SkipUnchangedFiles="true" />
	</Target>
</Project>
