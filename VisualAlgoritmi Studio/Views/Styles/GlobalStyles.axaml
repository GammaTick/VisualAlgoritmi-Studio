<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- ── ContextMenu theme resources ── -->
        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground">#1F1F1F</SolidColorBrush>
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush">#454545</SolidColorBrush>
        <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">2</Thickness>
        <x:Double x:Key="MenuFlyoutThemeMinHeight">0</x:Double>
        <Thickness x:Key="MenuFlyoutPresenterThemePadding">4,0</Thickness>
        <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,10</Thickness>
        <SolidColorBrush x:Key="MenuFlyoutItemForeground">White</SolidColorBrush>
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver">White</SolidColorBrush>
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed">White</SolidColorBrush>
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled">#888888</SolidColorBrush>
    </Styles.Resources>

    <!-- ── ScrollBar ── applied globally to every ScrollBar in the app ── -->

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="#1F1F1F" />
        <Setter Property="BorderBrush" Value="#101114" />
    </Style>

    <Style Selector="ScrollBar /template/ Border#VerticalRoot">
        <Setter Property="Background" Value="#1F1F1F" />
        <Setter Property="BorderBrush" Value="#101114" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ScrollBar /template/ Border#HorizontalRoot">
        <Setter Property="Background" Value="#1F1F1F" />
        <Setter Property="BorderBrush" Value="#101114" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ScrollBar /template/ Grid#Root">
        <Setter Property="Background" Value="#1F1F1F" />
    </Style>

    <Style Selector="ScrollBar[IsExpanded=true] /template/ Grid#Root">
        <Setter Property="Background" Value="#1F1F1F" />
    </Style>

    <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
        <Setter Property="Fill" Value="#1F1F1F" />
        <Setter Property="Stroke" Value="#1F1F1F" />
        <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="ScrollBar[IsExpanded=true] /template/ Rectangle#TrackRect">
        <Setter Property="Fill" Value="#1F1F1F" />
        <Setter Property="Stroke" Value="#1F1F1F" />
        <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ScrollBar[IsExpanded=true] /template/ RepeatButton">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="#373737" />
    </Style>

    <Style Selector="ScrollBar[IsExpanded=true] /template/ Thumb">
        <Setter Property="Background" Value="#373737" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb /template/ Border">
        <Setter Property="Background" Value="#373737" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pointerover /template/ Border">
        <Setter Property="Background" Value="#5F5F5F" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pressed /template/ Border">
        <Setter Property="Background" Value="#5F5F5F" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ── ContextMenu ── applied globally to every ContextMenu in the app ── -->

    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="#1F1F1F"/>
        <Setter Property="BorderBrush" Value="#454545"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="ContextMenu > MenuItem">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8, 10"/>
    </Style>

    <Style Selector="ContextMenu > MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="TextElement.Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ContextMenu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#2A2D2E"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="ContextMenu > MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>

    <Style Selector="ContextMenu > MenuItem:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#2A2D2E"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="ContextMenu > Separator">
        <Setter Property="Background" Value="#454545"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ── Menu dropdown items ── applied globally to every Menu flyout ── -->

    <Style Selector="MenuItem MenuItem">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="6,8"/>
    </Style>

    <Style Selector="MenuItem MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="MenuItem MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="TextElement.Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="MenuItem MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#2A2D2E"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="MenuItem MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>

    <Style Selector="MenuItem MenuItem:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#2A2D2E"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- Separator inside any MenuItem dropdown (Menu bar flyouts) -->
    <Style Selector="MenuItem > Separator">
        <Setter Property="Background" Value="#454545"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ── ToolTip ── matches Menu dropdown styling ── -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#1F1F1F"/>
        <Setter Property="BorderBrush" Value="#454545"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="8,10"/>
    </Style>

</Styles>
