<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svg="clr-namespace:Svg.Skia.Avalonia;assembly=Svg.Skia.Avalonia"
             xmlns:vm="clr-namespace:VisualAlgoritmi_Studio.ViewModels"
             xmlns:controls="clr-namespace:VisualAlgoritmi_Studio.Controls.CreditsFooter"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="VisualAlgoritmi_Studio.Views.AnimationPlaybackView"
             x:DataType="vm:AnimationPlaybackViewModel"
             Background="#1C1C1C">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.top-toolbar-button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">

        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                <Button Classes="top-toolbar-button"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding GoHomeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   Text="Начало" />
                        <Svg Width="24"
                             Height="24"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Path="/Assets/Icons/home.svg" />
                    </StackPanel>
                </Button>

                <Separator Width="1"
                           Margin="6,0" />

                <Button Classes="top-toolbar-button"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding ScreenshotCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   Text="Екранна снимка" />
                        <Svg Width="24"
                             Height="24"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Path="/Assets/Icons/screenshot.svg" />
                    </StackPanel>
                </Button>

                <Separator Width="1"
                           Margin="6,0" />

                <Button Classes="top-toolbar-button"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding ReverseStepCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   Text="Предишна стъпка" />
                        <Svg Width="24"
                             Height="24"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Path="/Assets/Icons/rewind-step.svg" />
                    </StackPanel>
                </Button>

                <Button Classes="top-toolbar-button"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding AdvanceStepCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   Text="Следваща стъпка" />
                        <Svg Width="24"
                             Height="24"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Path="/Assets/Icons/step-forward.svg" />
                    </StackPanel>
                </Button>

                <Button Classes="top-toolbar-button"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding RestartCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   Text="Рестартирай" />
                        <Svg Width="24"
                             Height="24"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Path="/Assets/Icons/reset-steps.svg" />
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Padding="0,4,0,4">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Border Padding="8,3"
                            Background="#252525"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Структура:"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       Foreground="#9E9E9E"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedDataStructureName}"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#D4D4D4"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding CanvasZoomText}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CanvasOffsetText}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    BorderThickness="2"
                    BorderBrush="#2b2b2b">
                <ContentControl Content="{Binding VisualizerCanvas}" />
            </Border>

            <Border Grid.Row="2"
                    Height="200"
                    Margin="0,8,0,0"
                    BorderThickness="2"
                    BorderBrush="#2b2b2b"
                    ClipToBounds="True">
                <StackPanel Margin="8" Spacing="10">
                    <TextBlock FontSize="16"
                               Foreground="#D4D4D4">
                        <Run FontWeight="Bold">Стъпка:</Run>
                        <Run Text="{Binding CurrentStepValueText}" />
                    </TextBlock>
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#D4D4D4"
                                   Text="{Binding OperationsPrefixText}" />
                        <TextBlock Text="{Binding CurrentOperationsText}"
                                   FontSize="16"
                                   Foreground="#D4D4D4"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <controls:CreditsFooter Grid.Row="2" Margin="10,0,10,0" />
    </Grid>
</UserControl>
